# Copy to .env and fill in. Never commit the real .env.
#
# SETUP:
# 1. TELEGRAM_API_ID / TELEGRAM_API_HASH: go to https://my.telegram.org ->
#    "API development tools", log in with your phone, create an app.
# 2. TELETHON_SESSION: run  `python login.py`  once. It logs in with your phone
#    + the code Telegram sends you, then prints the session string to paste here.
# 3. BOT_TOKEN: open @BotFather in Telegram -> /newbot -> copy the token.
#    Then add that bot as an ADMIN of your channel so it can post.
# 4. TARGET_CHANNEL_ID: your channel id (e.g. -100xxxxxxxxxx).
#
# Test:  python bot.py --dry-run   (prints matches, posts nothing)
# Post:  python bot.py

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION=
BOT_TOKEN=
TARGET_CHANNEL_ID=

# Free key from https://aistudio.google.com/app/apikey (for AI-written posts)
GEMINI_API_KEY=
